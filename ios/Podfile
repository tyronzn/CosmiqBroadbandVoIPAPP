# Flutter's standard iOS Podfile, with the local CosmiqSip pod added.
#
# Committed rather than left to `flutter build ios` to generate, because the
# generated one has no way to know about the native SIP engine.

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously, which slows every
# build for no benefit here.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path =
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running " \
          "pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        "Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # The native SIP engine. Staged into CosmiqSip/ by tools/build_native_ios.sh;
  # the podspec raises a readable error if that has not been run.
  pod 'CosmiqSip', :path => 'CosmiqSip'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Several pods still declare an older minimum than the app does, which
      # Xcode reports as a warning per pod per build and, for some, an error.
      # Pinning them all to the app's own floor keeps the log readable.
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
      if current < 13.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end
